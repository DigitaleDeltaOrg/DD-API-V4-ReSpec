{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://digitaledeltaorg.github.io/schemas/dd-api-v4/manifest.schema.json",
	"title": "DD API V4 Manifest",
	"description": "Machineleesbaar discovery-document voor een DD API V4 implementatie.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"apiVersion",
		"title",
		"provider",
		"baseUrl",
		"datasets"
	],
	"properties": {
		"apiVersion": {
			"type": "string",
			"description": "Versie van de DD API die door deze implementatie wordt aangeboden.",
			"const": "4.0"
		},
		"title": {
			"type": "string",
			"description": "Naam van de API-implementatie of dataservice.",
			"minLength": 1
		},
		"description": {
			"type": "string",
			"description": "Algemene beschrijving van de API-implementatie."
		},
		"provider": {
			"$ref": "#/$defs/agent"
		},
		"baseUrl": {
			"type": "string",
			"format": "uri",
			"description": "Basis-URL van de DD API V4 implementatie."
		},
		"landingPage": {
			"type": "string",
			"format": "uri",
			"description": "Webpagina met menselijke toelichting op de API of datasetcollectie."
		},
		"license": {
			"type": "string",
			"description": "Licentie waaronder de data of metadata beschikbaar is."
		},
		"authentication": {
			"type": "array",
			"description": "Ondersteunde authenticatiemethoden. Als none aanwezig is, is ten minste een deel van de API zonder authenticatie toegankelijk.",
			"minItems": 1,
			"items": {
				"type": "string",
				"enum": [
					"none",
					"mtls",
					"apiKey",
					"oauth2",
					"openIdConnect"
				]
			},
			"uniqueItems": true
		},
		"language": {
			"type": "array",
			"description": "Ondersteunde talen voor vertaalbare namen van domeintabellen, domeinwaarden en begrippen.",
			"minItems": 2,
			"maxItems": 2,
			"items": {
				"type": "string",
				"enum": [
					"en",
					"nl"
				]
			},
			"uniqueItems": true
		},
		"issued": {
			"type": "string",
			"format": "date",
			"description": "Publicatiedatum van het manifest."
		},
		"modified": {
			"type": "string",
			"format": "date-time",
			"description": "Datum en tijd waarop het manifest voor het laatst is gewijzigd."
		},
		"contactPoint": {
			"$ref": "#/$defs/contactPoint"
		},
		"dataService": {
			"$ref": "#/$defs/dataService"
		},
		"datasets": {
			"type": "array",
			"description": "Data-aanbiedingen die via deze API beschikbaar zijn.",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/dataset"
			}
		}
	},
	"$defs": {
		"agent": {
			"type": "object",
			"description": "Organisatie, persoon of dienst die verantwoordelijk is voor publicatie.",
			"additionalProperties": false,
			"required": [
				"name"
			],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"identifier": {
					"type": "string",
					"description": "Optionele identifier van de organisatie of agent."
				},
				"url": {
					"type": "string",
					"format": "uri"
				},
				"email": {
					"type": "string",
					"format": "email"
				}
			}
		},
		"contactPoint": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"name"
			],
			"properties": {
				"name": {
					"type": "string"
				},
				"email": {
					"type": "string",
					"format": "email"
				},
				"url": {
					"type": "string",
					"format": "uri"
				},
				"telephone": {
					"type": "string"
				}
			}
		},
		"dataService": {
			"type": "object",
			"description": "Beschrijving van de API als dataservice.",
			"additionalProperties": false,
			"required": [
				"endpointUrl"
			],
			"properties": {
				"title": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"endpointUrl": {
					"type": "string",
					"format": "uri"
				},
				"endpointDescription": {
					"type": "string",
					"format": "uri",
					"description": "URL naar OpenAPI, CSDL of andere machinaal leesbare endpointbeschrijving."
				},
				"servesDataset": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"dataset": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"semantics",
				"profiles",
				"resultTypes"
			],
			"properties": {
				"id": {
					"type": "string",
					"description": "Unieke identifier van de data-aanbieding binnen dit manifest.",
					"pattern": "^[A-Za-z0-9._:-]+$"
				},
				"title": {
					"type": "string",
					"minLength": 1
				},
				"description": {
					"type": "string"
				},
				"publisher": {
					"$ref": "#/$defs/agent"
				},
				"creator": {
					"$ref": "#/$defs/agent"
				},
				"contactPoint": {
					"$ref": "#/$defs/contactPoint"
				},
				"landingPage": {
					"type": "string",
					"format": "uri"
				},
				"license": {
					"type": "string"
				},
				"accessRights": {
					"type": "string",
					"enum": [
						"public",
						"restricted"
					]
				},
				"language": {
					"type": "string",
					"pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
				},
				"themes": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"uniqueItems": true
				},
				"keywords": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"uniqueItems": true
				},
				"issued": {
					"type": "string",
					"format": "date"
				},
				"modified": {
					"type": "string",
					"format": "date-time"
				},
				"accrualPeriodicity": {
					"type": "string",
					"description": "Actualisatiefrequentie, bijvoorbeeld continuous, daily, weekly, monthly of irregular."
				},
				"semantics": {
					"type": "string",
					"format": "uri",
					"description": "URI van de semantische definitie-set (in json) die voor deze data-aanbieding geldt."
				},
				"capabilities": {
					"type": "array",
					"description": "Ondersteunde functionele capabilities.",
					"items": {
						"type": "string"
					},
					"uniqueItems": true
				},
				"profiles": {
					"type": "array",
					"description": "Ondersteunde inhoudelijke of domeinspecifieke profiles.",
					"minItems": 1,
					"items": {
						"type": "string"
					},
					"uniqueItems": true
				},
				"resultTypes": {
					"type": "array",
					"description": "Ondersteunde typen observatieresultaten.",
					"minItems": 1,
					"items": {
						"type": "string",
						"enum": [
							"Values",
							"Series",
							"Grids",
							"Expectations",
							"Ensembles",
							"Collections"
						]
					},
					"uniqueItems": true
				},
				"temporalCoverage": {
					"$ref": "#/$defs/temporalCoverage"
				},
				"spatialCoverage": {
					"$ref": "#/$defs/spatialCoverage"
				},
				"endpoints": {
					"type": "array",
					"description": "Relevante API-endpoints voor deze data-aanbieding.",
					"items": {
						"$ref": "#/$defs/endpoint"
					}
				},
				"distributions": {
					"type": "array",
					"description": "Beschikbare distributies of toegangsvormen.",
					"items": {
						"$ref": "#/$defs/distribution"
					}
				}
			}
		},
		"temporalCoverage": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"start": {
					"type": "string",
					"format": "date-time"
				},
				"end": {
					"type": "string",
					"format": "date-time"
				}
			}
		},
		"spatialCoverage": {
			"type": "object",
			"description": "Ruimtelijke dekking van de data-aanbieding.",
			"additionalProperties": false,
			"properties": {
				"bbox": {
					"type": "array",
					"description": "Bounding box als [minLon, minLat, maxLon, maxLat].",
					"minItems": 4,
					"maxItems": 4,
					"items": {
						"type": "number"
					}
				},
				"crs": {
					"type": "string",
					"description": "Coordinate reference system van de bbox.",
					"default": "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
				},
				"geometry": {
					"type": "object",
					"description": "Optionele GeoJSON-geometrie."
				}
			}
		},
		"endpoint": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"url"
			],
			"properties": {
				"name": {
					"type": "string"
				},
				"url": {
					"type": "string",
					"format": "uri"
				},
				"description": {
					"type": "string"
				},
				"mediaTypes": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"uniqueItems": true
				}
			}
		},
		"distribution": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"accessUrl"
			],
			"properties": {
				"title": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"accessUrl": {
					"type": "string",
					"format": "uri"
				},
				"downloadUrl": {
					"type": "string",
					"format": "uri"
				},
				"mediaType": {
					"type": "string",
					"description": "Media type, bijvoorbeeld application/json, application/geo+json of application/prs.coverage+json."
				},
				"format": {
					"type": "string"
				}
			}
		}
	}
}